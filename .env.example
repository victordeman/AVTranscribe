# Redis Broker URL (required for Celery)
REDIS_URL=redis://localhost:6379/0

# Database URL (SQLAlchemy compatible)
DB_URL=sqlite:///transcriptions.db

# Hugging Face Model ID (default: distil-whisper/distil-large-v3)
HF_MODEL_ID=distil-whisper/distil-large-v3

# Hugging Face Inference API Token (required for Serverless Mode on Vercel)
HF_TOKEN=your_hf_token_here

# API Rate Limit
RATE_LIMIT=10/minute

# Optional: Set to 'true' to force usage of Hugging Face API instead of local model
USE_HF_API=false

# Legacy: OpenAI API Key (now using HF by default)
# OPENAI_API_KEY=your_openai_key_here
